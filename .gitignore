# ============================================================
#  Saral – AI Form Assistant  |  .gitignore
#  Open-source project — secrets must NEVER be committed.
# ============================================================


# ───────────────────────────────────────────────────────────
#  🔐 SECRETS & CREDENTIALS  (highest priority — always keep)
# ───────────────────────────────────────────────────────────

# Environment files — real keys live here, never commit them
.env
.env.*
!.env.example          # ← the template IS safe to commit

# API keys / certificates accidentally dropped in the tree
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
secrets/
credentials/
service-account*.json  # Google Cloud service account files


# ───────────────────────────────────────────────────────────
#  📦 DEPENDENCIES
# ───────────────────────────────────────────────────────────

# npm / pnpm / yarn
node_modules/
.pnpm-store/
.yarn/
.yarn-integrity

# Package lock files — keep package-lock.json and pnpm-lock.yaml
# but ignore platform-specific Yarn PnP artefacts
.pnp.js
.pnp.cjs


# ───────────────────────────────────────────────────────────
#  🏗  BUILD OUTPUTS
# ───────────────────────────────────────────────────────────

# WXT (Chrome extension builder)
extension/.output/
extension/.wxt/

# TypeScript compiled output
dist/
build/
out/
*.tsbuildinfo
*.js.map
*.d.ts.map

# Backend compiled JS (tsc --outDir dist)
backend/dist/

# Chrome extension packages — do not commit zips / CRX binaries
*.zip
*.crx
*.xpi                  # Firefox


# ───────────────────────────────────────────────────────────
#  📝 LOGS
# ───────────────────────────────────────────────────────────

*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# WXT / Vite build logs
vite-*.log


# ───────────────────────────────────────────────────────────
#  🧪 TEST ARTEFACTS
# ───────────────────────────────────────────────────────────

coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
*.snap          # only if you intentionally track snapshots — remove this line then


# ───────────────────────────────────────────────────────────
#  🖥  OS-GENERATED FILES
# ───────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.nfs*


# ───────────────────────────────────────────────────────────
#  🛠  EDITORS & IDEs
# ───────────────────────────────────────────────────────────

# VS Code — keep shared settings but ignore personal overrides
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# Sublime Text
*.sublime-workspace

# Cursor / Windsurf
.cursor/
.windsurf/


# ───────────────────────────────────────────────────────────
#  🔬 RUNTIME & TEMP FILES
# ───────────────────────────────────────────────────────────

tmp/
temp/
.tmp/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.pid
*.seed
*.pid.lock

# Vite / WXT dev server cache
.vite/


# ───────────────────────────────────────────────────────────
#  🌐 EXTENSION-SPECIFIC
# ───────────────────────────────────────────────────────────

# Unpacked extension directory created by "Pack extension" in Chrome
extension-packed/

# Screenshots auto-captured during Playwright E2E runs
test-screenshots/


# ───────────────────────────────────────────────────────────
#  🗂  PROJECT-SPECIFIC
# ───────────────────────────────────────────────────────────

# Figma exports dropped locally (design assets go in Saral – UI/ as-is)
# Keep the UI folder but exclude any raw exports that may contain tokens
*.fig

# Local dev notes — not meant for the repo
TODO.local.md
NOTES.local.md
scratch/
